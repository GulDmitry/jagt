{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": ["mcp__jagt-orchestrator"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | \"$(git rev-parse --show-toplevel)/scripts/guards/no-poll-loop.sh\""
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | \"$(git rev-parse --show-toplevel)/scripts/guards/no-shared-kill.sh\""
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | \"$(git rev-parse --show-toplevel)/scripts/guards/push-after-local-ci.sh\""
          },
          {
            "type": "command",
            "command": "jq -r 'select(.agent_type == \"jagt-reviewer\") | .tool_input.command // empty' | \"$(git rev-parse --show-toplevel)/scripts/guards/reviewer-read-only.sh\""
          }
        ]
      }
    ]
  }
}
