# jagt — your whole configuration, and the only file there is: `cp jagt.yml.dist jagt.yml`, then fill in ONE
# project. Every other key already has the value shown and can stay commented out.
# `projects` is re-read on every access; the rest is read once, at startup.

orchestrator:

  # ── Your repositories ──────────────────────────────────────────────────────────────────────────────────────
  # The only section with no default. `deploy` merges a task into `deployBranch`, which must differ from
  # `baseBranch`, or jagt refuses to start.
  projects:
    my-project:
      path: /absolute/path/to/base/repository
      baseBranch: origin/main       # tasks are cut from here; jagt never pushes to it
      deployBranch: dev             # omit to disable deploy for this project
      # labels: [proj, my-project]  # ticket labels that pick this project when `do` names none

  # ── Platform ───────────────────────────────────────────────────────────────────────────────────────────────
  platform: macos          # macos | linux. Not detected: refused when it is not what the machine reports
  # kittyCommand: kitty   # if the binary is not on PATH
  # kittyFontSize: 13     # blank keeps kitty.conf's own
  tmuxCommand: tmux       # a bare name is resolved on PATH and in the usual install dirs
  # terminalNotifierCommand: terminal-notifier   # macOS: clickable banners; falls back to osascript
  # notifySendCommand: notify-send               # Linux: the libnotify sender

  # Any CLI launcher; the worktree path is appended. NOT `open -a`, which activates the app but opens nothing.
  editorCommand: ["idea"]
  editorDiffCommand: ["idea", "diff"]     # two paths are appended: <left> <right>

  # ── The viewer ─────────────────────────────────────────────────────────────────────────────────────────────
  openTerminalWindow: true  # false: never open a kitty window; attach to the tmux session yourself
  viewer:
    tmuxSession: jagt     # tmux reserves ':' and '.' — a name carrying either is unaddressable
    viewMode: shared      # shared | tab-per-task
    keepViewer: true      # keep the agents window open after the last task closes

  # ── The agents ─────────────────────────────────────────────────────────────────────────────────────────────
  agent:
    # cli: codex          # claude | codex; read at startup, unlike the two below. A Codex worktree runs
    #                     # against its own CODEX_HOME, so your ~/.codex servers are not there.
    outputStyle: ""       # a Claude output style to start every sub-agent with
    probeSeconds: 600     # how often every running session's liveness is probed

  claude:
    command: claude       # also used by the headless reads, which stay Claude whichever agent runs the tasks
  # codex:
  #   command: codex

  # The built-in prompt starts every sub-agent on task_context.md and holds it to leaving work uncommitted.
  # agentPrompt: >-
  #   You are the sub-agent for this worktree. …

  watchdog:
    staleAfter: 5m        # silence before an "agent stopped" alert; a hook report needs no wait

  # agentDisabledPlugins:   # dropping an LSP plugin buys memory and costs the agent its code intelligence
  #   - jdtls-lsp@claude-plugins-official

  worktree:
    copyGlobs: ["**/.env"]   # gitignored files carried from the base repository into every fresh worktree

  # ── Reading tickets, merge requests and review rounds ──────────────────────────────────────────────────────
  # The only place jagt spends model money. Each read is a HEADLESS one-shot of your agent CLI: no interactive
  # login, no plugin-scoped MCP server. Read docs/installation.md before trusting it.
  assistant:
    model: haiku                        # blank inherits your own; the reads are mechanical
    settingSources: user,project,local  # NOT `project` alone: the call runs from a temp dir, which has none
    permissionMode: bypassPermissions   # nothing can answer a permission prompt in a headless call
    # allowedTools: [mcp__your-jira-mcp, mcp__your-gitlab-mcp]   # takes precedence over permissionMode
    # mcpConfig: /path/to/mcp-servers.json   # pin the servers instead of inheriting all of them

  # ── Review rounds ──────────────────────────────────────────────────────────────────────────────────────────
  codeReview:
    mrTitlePattern: "{ticket} {title}"
    postReviewReplies: true    # false leaves every reply a draft for you to post by hand
    reviewReplyAuthors: []     # only reply to threads opened by these authors; empty = all of them
    mergeRequestDefaults:
      removeSourceBranch: true
      squash: true

  # Unattended polling of open review requests: it only READS and DRAFTS, never ships, deploys or posts.
  # One model call per poll — 24h on one request is $3–$7.
  autoReview:
    enabled: false
    windowHours: 24         # stop polling a round this old
    minIntervalMinutes: 10
    maxIntervalMinutes: 60

  # ── Safety ─────────────────────────────────────────────────────────────────────────────────────────────────
  startupChecks: true     # refuse to start when part of the installation is missing

# Six more keys work here, left out because almost nobody sets them: `mcpUrl`, `hookUrl` and `gateUrl` are
# derived from `server.port`, `stub.script` is for the e2e matrix, and `root` and `stateFile` move where
# worktrees are cut and where state.json is kept. `configFile` alone cannot live here — it says where THIS file
# is: pass `--orchestrator.config-file=…` or `ORCHESTRATOR_CONFIG_FILE=…`.

# The board listens on loopback: it asks for no password and can deploy, close a task and start an agent.
server:
  address: 127.0.0.1
  port: 8290
