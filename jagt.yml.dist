# jagt — your whole configuration.
#
#   cp jagt.yml.dist jagt.yml
#
# and fill in ONE project. Everything else already has the value shown, so a key you do not care about can stay
# commented out — and a key you do care about is here, with what it means. Nothing is configured anywhere else.
#
# `projects` is re-read on every access; the rest is read once, at startup.

orchestrator:

  # ── Your repositories ──────────────────────────────────────────────────────────────────────────────────────
  # The only section with no default. A task is cut from `baseBranch` and `deploy` merges it into
  # `deployBranch` — those two must differ, or jagt refuses to start.
  projects:
    my-project:
      path: /absolute/path/to/base/repository
      baseBranch: origin/main
      deployBranch: dev
      # Ticket labels that pick this project when `do` names no project. Omit and you name it yourself.
      # labels: [proj, my-project]

  # ── Platform ───────────────────────────────────────────────────────────────────────────────────────────────
  # Not detected: jagt refuses to start when this is not what the machine reports.
  platform: macos          # macos | linux
  # kittyCommand: kitty   # if the binary is not on PATH
  # kittyFontSize: 13    # blank keeps kitty.conf's own (default 11)
  tmuxCommand: tmux       # a bare name is resolved on PATH and in the usual install dirs

  # Any CLI launcher; the worktree path is appended. `open -a` will NOT do — it activates the app without
  # opening what you passed it.
  editorCommand: ["idea"]
  editorDiffCommand: ["idea", "diff"]     # two paths are appended: <left> <right>

  # ── The viewer ─────────────────────────────────────────────────────────────────────────────────────────────
  openTerminalWindow: true  # false: never open a kitty window; attach to the tmux session yourself
  viewer:
    tmuxSession: jagt     # tmux reserves ':' and '.' — a name carrying either is unaddressable
    viewMode: shared      # shared | tab-per-task
    keepViewer: true      # keep the agents window open after the last task closes

  # ── The agents ─────────────────────────────────────────────────────────────────────────────────────────────
  agent:
    # cli: codex          # claude | codex. A Codex worktree runs against its own CODEX_HOME, so your
    #                     # ~/.codex servers are not there. Read at startup; the two below are read live.
    outputStyle: ""       # a Claude output style to start every sub-agent with
    probeSeconds: 600     # how long a session may be quiet before its liveness is probed the expensive way

  claude:
    command: claude       # also used by the headless reads, which stay Claude whichever agent runs the tasks
  # codex:
  #   command: codex

  watchdog:
    staleAfter: 5m        # silence before an "agent stopped" alert; a hook report needs no wait

  # Opt-in for RAM-constrained setups: dropping an LSP plugin buys memory and costs the agent its code
  # intelligence.
  # agentDisabledPlugins:
  #   - jdtls-lsp@claude-plugins-official

  worktree:
    copyGlobs: ["**/.env"]   # files carried from the base repository into every fresh worktree

  # ── Reading tickets and review rounds ──────────────────────────────────────────────────────────────────────
  # The only place jagt spends model money. Each read is a HEADLESS one-shot of your agent CLI, which cannot log
  # in interactively and does not load plugin-scoped MCP servers — see docs/installation.md before trusting it.
  assistant:
    model: haiku                        # blank inherits your own; the reads are mechanical
    settingSources: user,project,local # NOT `project` alone: the call runs from a temp dir, which has none
    permissionMode: bypassPermissions  # nothing can answer a permission prompt in a headless call
    # allowedTools: [mcp__your-jira-mcp, mcp__your-gitlab-mcp]   # takes precedence over permission-mode
    # mcpConfig: /path/to/mcp-servers.json   # pin the servers instead of inheriting all of them

  # ── Review rounds ──────────────────────────────────────────────────────────────────────────────────────────
  codeReview:
    mrTitlePattern: "{ticket} {title}"
    postReviewReplies: true    # false leaves every reply a draft for you to post by hand
    reviewReplyAuthors: []     # only reply to threads opened by these authors; empty = all of them
    mergeRequestDefaults:
      removeSourceBranch: true
      squash: true

  # Unattended polling of open review requests. It only READS and DRAFTS — it never ships, deploys or posts.
  # It costs a model call per poll: 24h on one request is $3–$7.
  autoReview:
    enabled: false
    windowHours: 24         # stop polling a round this old
    minIntervalMinutes: 10
    maxIntervalMinutes: 60

  # ── Safety ─────────────────────────────────────────────────────────────────────────────────────────────────
  # Refuse to start when part of the installation is missing, rather than failing at the click that needs it.
  startupChecks: true

# The board listens on loopback: it asks for no password and can deploy, close a task and start an agent.
# Widening this is a line you write yourself, knowing that.
server:
  address: 127.0.0.1
  port: 8290
