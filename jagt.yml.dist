# jagt — your whole configuration, and the only file there is: `cp jagt.yml.dist jagt.yml`, then fill in ONE
# project. Every other key already has the value shown and can stay commented out.
# `projects`, `viewer`, `agent`, `worktree`, `codeReview`, `autoReview`, `master`, `tracker`, `maxStartsPerDay`,
# `loopBreaker`, `conflictStallMinutes` and `archive` are re-read on every access; every other key is read once, at startup.

orchestrator:

  # ── Your repositories ──────────────────────────────────────────────────────────────────────────────────────
  # The only section with no default. `deploy` merges a task into `deployBranch`, which must differ from
  # `baseBranch`, or jagt refuses to start.
  projects:
    my-project:
      path: /absolute/path/to/base/repository
      baseBranch: origin/main       # tasks are cut from here; jagt never pushes to it
      deployBranch: dev             # omit to disable deploy for this project
      # labels: [proj, my-project]  # ticket labels suggesting this project where `do` names none
      # about: "the Java backend behind the customer portal"   # what this repository IS, in one line, for
      #                             # placing an item no label places; its path is used where you write none
      # verifyCommand: ["./gradlew", "test"]   # jagt runs it in the worktree before a hand-back reaches you;
                                               # a failing run goes back to the agent, never to your IDE
      # humanPaths: ["**/auth/**", "**/*secret*"]   # in `master.mode: act`, a task changing a path these globs
      #                             # name is shipped and deployed by you alone; the master window names the path

  # ── Platform ───────────────────────────────────────────────────────────────────────────────────────────────
  platform: macos          # macos | linux. Not detected: refused when it is not what the machine reports
  archive:
    maxMegabytes: 20       # `archive/` beside state.json, what `done` keeps; past it the oldest snapshots go first
  loopBreaker:             # stops a task jagt suspects it is looping on, whoever asked; only your `lift` resumes it
    stalledRounds: 3       # rounds relayed running that brought no new note and left the same job failing (at most 19)
    ships: 4               # ships within autoReview.windowHours whose round brought no new note;
                           # the next one jagt would press unasked stops the task
    rounds: 3              # rounds of one step sent back running in 24h: a red verification or probe, a not-ready
                           # plan or round, counted while it answers an unchanged report; the next one stops the task (at most 19)
    perHour: 20            # unattended moves (Master, auto-review, tracker) of one task in an hour; the next one stops it (at most 49)
  conflictStallMinutes: 20 # in act, a deploy conflict its session was handed whose worktree has not changed this long:
                           # you get one banner, and the card says how many paths are unmerged, where, since when
  keepAwake: false         # true: macOS stays awake while the Master acts, auto-review polls or `take` runs
  interactionLog: true     # what you press on the board, to `interactions.jsonl` beside state.json; 1 MB, one `.1`
  # terminal: kitty       # kitty | ghostty: the viewer; ghostty is macOS only and needs Ghostty 1.3 or newer
  # kittyCommand: kitty   # if the binary is not on PATH
  # kittyFontSize: 13     # blank keeps kitty.conf's own
  tmuxCommand: tmux       # a bare name is resolved on PATH and in the usual install dirs
  # terminalNotifierCommand: terminal-notifier   # macOS: clickable banners; falls back to osascript
  # notifySendCommand: notify-send               # Linux: the libnotify sender

  # Any CLI launcher; the worktree path is appended. NOT `open -a`, which activates the app but opens nothing.
  editorCommand: ["idea"]
  editorDiffCommand: ["idea", "diff"]     # optional; two paths are appended: <left> <right>
  # VS Code: editorCommand: ["code"], editorDiffCommand: ["meld"] (brew install --cask meld) — VS Code compares no folders

  # ── The viewer ─────────────────────────────────────────────────────────────────────────────────────────────
  openTerminalWindow: true  # false: never open a kitty window; attach to the tmux session yourself
  viewer:
    tmuxSession: jagt     # tmux reserves ':' and '.' — a name carrying either is unaddressable
    viewMode: shared      # shared | tab-per-task
    keepViewer: true      # keep the agents window open after the last task closes

  # ── The agents ─────────────────────────────────────────────────────────────────────────────────────────────
  agent:
    # cli: codex          # claude | codex (stub, replay: test runs); read at startup, unlike the two below. A Codex worktree runs
    #                     # against its own CODEX_HOME, so your ~/.codex servers are not there.
    outputStyle: ""       # a Claude output style to start every sub-agent with
    model: ""             # the model a session starts on when its notes name none; blank inherits your CLI default
    cacheLifetime: 1h     # idle past this, a prompt goes to a fresh session; 0: never (a local model)
    notesEvery: 30m       # task_notes.md older than this at a turn end: the session rewrites it once; 0: never
    probeSeconds: 600    # how often every running session's liveness is probed
    sandbox:              # true: a session's shell writes only in its task's worktrees, /tmp, the user's temp dir and the tool caches;
                          # a write beyond asks you in the session's window. Claude's sandbox then lets only its web proxy out, which
                          # a JVM build (Gradle, Maven) does not use: it cannot reach the network
      enabled: false      # off: it writes wherever the agent CLI's own rules let it. Linux needs bwrap and socat when true
    #   allowWrite: []    # added to those, e.g. ~/www/specs
    #   excludedCommands: []   # run outside it beside git's remote verbs and ssh, e.g. "~/bin/db-tunnel *"
    # autoplan:           # a session plans first, unasked, when its task is large or unclear; the plan says why
    #   enabled: false
    #   files: 30         # "large": it changes more files than this
    visualize:            # a session sketches a task worth a picture in task_visual.md: ASCII for a screen, Mermaid
                          # for the backend; the board's Files tab shows it
      enabled: true       # unset: off
    # diagnose:           # a session diagnoses a bug from facts and a control before it reads code for a cause
    #   enabled: false

  claude:
    command: claude       # also used by the headless reads, which stay Claude whichever agent runs the tasks
    # mcpConfig: /path/to/servers.json   # a session loads jagt's server and these alone, none of yours
  # codex:
  #   command: codex

  # What a session is told at each step jagt sends it: session-brief.md.dist; copy it to session-brief.md to edit a step.
  # When jagt may send each step: session-cases.md.dist; copy it to session-cases.md to edit a case.
  # When the Master may press a verb: master-cases.md.dist; copy it to master-cases.md to edit a case.

  watchdog:
    staleAfter: 5m        # silence before an "agent stopped" alert; a hook report needs no wait

  # agentDisabledPlugins:   # dropping an LSP plugin buys memory and costs the agent its code intelligence
  #   - jdtls-lsp@claude-plugins-official

  # Pre-approved in every session: a ship's request and its replies write to the code host, which the auto-mode
  # classifier may refuse otherwise. One comma-separated line; never a merge tool, the base branch is read-only.
  # agentAllowedTools: mcp__your-gitlab-mcp__save_merge_request, mcp__your-gitlab-mcp__save_note

  worktree:
    copyGlobs: ["**/.env"]   # gitignored files carried from the base repository into every fresh worktree

  # ── Reading tickets, merge requests and review rounds ──────────────────────────────────────────────────────
  # The only place jagt spends model money. Each read is a HEADLESS one-shot of your agent CLI: no interactive
  # login, and a plugin's MCP server only with `user` in settingSources. Read docs/installation.md before trusting it.
  # `agent.cli: stub` (the e2e matrix's) replaces the task agent alone: `do` and the reads still run `claude.command`.
  assistant:
    model: haiku                        # blank inherits your own; the reads are mechanical
    settingSources: user,project,local  # NOT `project` alone: the call runs from a temp dir, which has none
    maxCostUsd: 1.75                    # a headless call stops at this spend and its read fails naming it
    breakerFailures: 3                  # consecutive model-provider failures (5xx, overloaded, network; never a usage limit) that stop every headless read
    breakerCooldown: 5m                 # how long reads stay stopped; then one probe read closes the breaker on success, re-opens it on failure
    # allowedTools: [mcp__your-jira-mcp, mcp__your-gitlab-mcp]   # a bare server gives a read its get*/list*/search*/
    #                     # read*/fetch*/find*/describe*/lookup*/*discussions*/*notes* tools, a full tool name
    #                     # that tool too; the Master's review calls these alone, and with none it loads no server
    # mcpConfig: /path/to/mcp-servers.json   # pin the servers instead of inheriting all of them; handed to `claude --mcp-config` as is
    # mcpConfigByKind:                       # one list per kind of read, so a cheap one loads only what it needs
    #   TICKET_READ: /path/to/tracker-only.json     # falls back to mcpConfig, then to your own configuration
    #   REVIEW_SWEEP: /path/to/code-host-only.json  # kinds: TICKET_READ, MR_READ, REVIEW_SWEEP, COMMAND_MAP, INTAKE, ROUTE, MASTER_REVIEW

  # ── The Master session ──────────────────────────────────────────────────────────────────────────────────────
  # An unattended reviewer that reads what a task produced before you do. It judges unless you turn it off; what
  # each mode does and costs: docs/usage.md#the-master.
  master:
    # mode: judge            # off | judge (reads and writes what it found) | act (also presses the button).
                             # Unset: judge where the agent CLI lets jagt read what you typed (Claude), else off.
                             # Three tasks in a row act moved ending badly stop it until you press `act stopped`;
                             # so does maxStartsPerDay, until tomorrow
    # brief: master-brief.md # what it judges by: copy master-brief.md.dist to this name and edit it. Relative
                             # to this file. Unset and not copied, the shipped .dist; named and missing, refused
    # model: fable           # reading is the cheap half, so it can run a heavier model than the work does;
                             # blank inherits the agent CLI's. One run per role of the brief, per round;
                             # a `model` column in the brief's role table overrides it for that role
    # mine: [plan]           # the steps that stay YOURS in `act`: ship, deploy + revert (together), reply, answer, plan,
                             # repo (attaching a repository a session asked for).
                             # Unset: [plan]; [] hands the Master every step. Anything not listed the Master may do;
                             # closing a task and a plan you opened in `plan` mode are always yours

  # ── The two ends the tracker drives (EXPERIMENTAL) ─────────────────────────────────────────────────────────
  # `take` turns items at your starting stage into tasks; `close` ends a task whose item reached the stage that
  # says the work landed. Each end asks only for the stage IT reads. Every stage name is YOUR workflow's:
  # nothing here has a default, because a guessed stage starts work nobody asked for.
  # Per poll: one search, then one read per item it has not seen. Labels naming exactly one project place the
  # item; otherwise a routing call OPENS the item and reads it against each project's `about`. A routing call
  # that fails is asked again next poll; only one that read the item and placed it nowhere turns it away.
  # It is also shown where items like it were finished before — only the ones you placed yourself or a deploy
  # confirmed, read off `finished.jsonl`, so it never learns from a guess of its own. With one repository configured there is
  # nothing to choose and nothing is asked.
  tracker:
    mode: off             # off | take | close | both
    workflow: none        # none | jira. Read at startup, unlike everything beside it here
    assignee: ""          # `take`: the item is yours, spelled exactly as your tracker reports it, case aside
    startStatus: ""       # `take`: the stage an item must stand in before a machine may start it
    projects: []          # `take`: the tracker projects (boards) work is taken from, by key; empty takes from all
    doneStatus: ""        # `close`: the stage that says the work landed; reaching it closes the task
    everyMinutes: 10      # a task the tracker has not moved is then asked about ever less often,
                          # doubling to twice a day, so a deploy nobody finishes stops costing reads
  # It writes what placed an item no label could place to `memory/routing.md`, one rule per line, each with
  # how many items it has placed. Past 60 the least used goes, not the oldest. A rule stops being used when
  # the router changes its mind or when you place by hand an item it had placed elsewhere, and is kept,
  # commented out with the date. Open the file and fix a line: it outranks everything else the router is shown, and you can
  # write rules there before the first item of their kind ever arrives.

  # ── Review rounds ──────────────────────────────────────────────────────────────────────────────────────────
  codeReview:
    mrTitlePattern: "{ticket} {title}"
    postReviewReplies: true    # false leaves every reply a draft for you to post by hand
    reviewReplyAuthors: []     # post a reply only where the note it answers is by these authors; empty = all

  # Unattended polling of open review requests: it only READS and DRAFTS, never ships, deploys or posts.
  # The one exception is `infraWait`: jagt re-runs a pipeline the host says died on infrastructure.
  # One model call per poll — 24h on one request is $3–$7.
  autoReview:
    enabled: false
    windowHours: 24         # stop polling a round this old
    minIntervalMinutes: 10
    maxIntervalMinutes: 60

  # ── Infrastructure failures ────────────────────────────────────────────────────────────────────────────────
  # A pipeline the host says died on infrastructure, not on the code, is re-run by jagt after each wait here; one
  # still red after the last is handed to you, and the session never hears of it. [] turns this off.
  infraWait:
    backoff: [5m, 15m, 45m]

  # ── Subscription limits ────────────────────────────────────────────────────────────────────────────────────
  # Read through the agent CLI's own stored login, never kept; shown in `stats` and told as a banner, never a gate.
  usageLimits:
    enabled: true             # false: nothing is read, told or shown
    every: 30m
    thresholds: [80, 95]      # % of a window, each told once per window period
    paidThresholds: [80, 95]  # % of paid usage's monthly limit; the first paid spend is always told
    wakeOnReset: false        # say one line to a session that stopped on a full window, when it resets

  # ── Safety ─────────────────────────────────────────────────────────────────────────────────────────────────
  startupChecks: true     # refuse to start when part of the installation is missing

  # ── Almost nobody sets these ───────────────────────────────────────────────────────────────────────────────
  # root: /path/to/jagt          # where worktrees are cut; default the jagt checkout
  # stateFile: /path/to/state.json   # where the tasks are kept; default `root`/state.json
  # mcpUrl: http://127.0.0.1:8290/mcp                   # these three follow `server.port`
  # hookUrl: http://127.0.0.1:8290/api/agent/session
  # gateUrl: http://127.0.0.1:8290/api/agent
  # stub:
  #   script: …                # the e2e matrix's scripted agent
  # replay:
  #   file: …/recording.jsonl  # `agent.cli: replay` plays a stand run's sessions, reads and verdicts back, no model
  # configFile: cannot live here, it says where THIS file is:
  #   `--orchestrator.config-file=…` or `ORCHESTRATOR_CONFIG_FILE=…`

# The board listens on loopback: it asks for no password and can deploy, close a task and start an agent.
server:
  address: 127.0.0.1
  port: 8290
