# The size of the GitHub-hosted Linux runner the local gate's container is capped to.
# https://docs.github.com/en/actions/reference/runners/github-hosted-runners
RUNNER_CPUS=4
RUNNER_MEMORY_GB=16
# The CPU quota the local container gets: calibrated so each suite takes at least as long as on the hosted runner (JAGT-233).
CONTAINER_CPUS=1.25
