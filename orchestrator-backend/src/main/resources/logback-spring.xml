<?xml version="1.0" encoding="UTF-8"?>

<!--
Past 10MB a log rolls into `<log>.1`, replacing the last one. Boot's own appender rolls daily and keeps a week of
archives. `LogFileRoll` rolls the backend log and the Master's into `.1` at start and keeps the old `.1` dated for 14 days.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Boot's console appender, declared here to carry the alias filter every appender needs. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${CONSOLE_LOG_THRESHOLD}</level>
        </filter>
        <filter class="dev.jagt.orchestrator.surface.ui.TaskAliasLogFilter"/>
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${FILE_LOG_THRESHOLD}</level>
        </filter>
        <filter class="dev.jagt.orchestrator.surface.ui.TaskAliasLogFilter"/>
        <!-- The file is read by a machine, the console by a human: `logging.pattern.console` is the human's. -->
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>ecs</format>
            <charset>${FILE_LOG_CHARSET}</charset>
        </encoder>
        <file>${LOG_FILE:-jagt-backend.log}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>${LOG_FILE:-jagt-backend.log}.%i</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>1</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>10MB</maxFileSize>
        </triggeringPolicy>
    </appender>

    <!-- The human's: what the Master does, followed in the `master` window (`MasterFeedWindow`). -->
    <springProperty name="MASTER_LOG" source="logging.master.name" defaultValue="jagt-master.log"/>
    <appender name="MASTER" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="dev.jagt.orchestrator.surface.ui.TaskAliasLogFilter"/>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ssX, UTC} %highlight(%msg) %kvp%n</pattern>
        </encoder>
        <file>${MASTER_LOG}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>${MASTER_LOG}.%i</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>1</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>10MB</maxFileSize>
        </triggeringPolicy>
    </appender>
    <logger name="dev.jagt.orchestrator.job.MasterAnswerJob"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.job.MasterStopJob"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.job.MasterReviewJob"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.job.MasterVerdicts"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.job.MasterPress"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.job.ConflictHandOff"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.job.ConflictFinish"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.MasterPanel"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.MasterBriefs"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.MasterDecisions"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.MasterReview"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.MasterBrake"><appender-ref ref="MASTER"/></logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
