<?xml version="1.0" encoding="UTF-8"?>

<!--
One run, one file. Boot's own file appender is a RollingFileAppender that rolls at midnight and keeps a week
of `<log>.<date>.<n>.gz` beside it, so a jagt left running for days grows an archive a day that nothing sweeps
until the next start. A plain FileAppender never writes a second file; `LogFileReset` empties this one before
the appender opens it.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${FILE_LOG_THRESHOLD}</level>
        </filter>
        <!-- The file is read by a machine, the console by a human: `logging.pattern.console` is the human's. -->
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>ecs</format>
            <charset>${FILE_LOG_CHARSET}</charset>
        </encoder>
        <file>${LOG_FILE:-jagt-backend.log}</file>
    </appender>

    <!-- The human's: what the Master does, followed in the `master` window (`MasterFeedWindow`). -->
    <appender name="MASTER" class="ch.qos.logback.core.FileAppender">
        <encoder>
            <pattern>%gray(%d{HH:mm:ss}) %highlight(%msg) %kvp%n</pattern>
        </encoder>
        <file>jagt-master.log</file>
    </appender>
    <logger name="dev.jagt.orchestrator.service.MasterAnswerJob"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.MasterReviewJob"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.MasterVerdicts"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.MasterShip"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.MasterDeployJob"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.DeployConflictJob"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.MasterPanel"><appender-ref ref="MASTER"/></logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
