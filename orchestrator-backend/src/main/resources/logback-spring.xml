<?xml version="1.0" encoding="UTF-8"?>

<!--
Past 10MB a log rolls into `<log>.1`, replacing the last one. Boot's own appender rolls daily and keeps a week of
archives. `LogFileRoll` rolls the backend log and the Master's into `.1` at start and keeps the old `.1` dated for 14 days.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
    The board's role logs: one in-memory feed per model role, `ROLE_<id>`, on the classes of the role's module (`RoleModules`).
    A role added later declares its appender and loggers here, and a `ModelRole` bean.
    -->
    <appender name="ROLE_master" class="dev.jagt.orchestrator.surface.ui.log.RecentLines">
        <filter class="dev.jagt.orchestrator.surface.ui.log.TaskAliasLogFilter"/>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ssX, UTC} %msg %kvp%n</pattern>
        </encoder>
    </appender>
    <logger name="dev.jagt.orchestrator.job.verdict.MasterAnswerJob"><appender-ref ref="ROLE_master"/></logger>
    <logger name="dev.jagt.orchestrator.job.master.MasterStopJob"><appender-ref ref="ROLE_master"/></logger>
    <logger name="dev.jagt.orchestrator.job.verdict.MasterReviewJob"><appender-ref ref="ROLE_master"/></logger>
    <logger name="dev.jagt.orchestrator.job.verdict.MasterVerdicts"><appender-ref ref="ROLE_master"/></logger>
    <logger name="dev.jagt.orchestrator.job.verdict.MasterPlanVerdicts"><appender-ref ref="ROLE_master"/></logger>
    <logger name="dev.jagt.orchestrator.job.master.MasterPress"><appender-ref ref="ROLE_master"/></logger>
    <logger name="dev.jagt.orchestrator.job.conflict.ConflictHandOff"><appender-ref ref="ROLE_master"/></logger>
    <logger name="dev.jagt.orchestrator.job.conflict.ConflictFinish"><appender-ref ref="ROLE_master"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.MasterPanel"><appender-ref ref="ROLE_master"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.MasterBriefs"><appender-ref ref="ROLE_master"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.MasterDecisions"><appender-ref ref="ROLE_master"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.MasterReview"><appender-ref ref="ROLE_master"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.MasterBrake"><appender-ref ref="ROLE_master"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.ChargedReviews"><appender-ref ref="ROLE_master"/></logger>
    <appender name="ROLE_acceptance" class="dev.jagt.orchestrator.surface.ui.log.RecentLines">
        <filter class="dev.jagt.orchestrator.surface.ui.log.TaskAliasLogFilter"/>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ssX, UTC} %msg %kvp%n</pattern>
        </encoder>
    </appender>
    <logger name="dev.jagt.orchestrator.job.checker"><appender-ref ref="ROLE_acceptance"/></logger>
    <logger name="dev.jagt.orchestrator.service.scenario"><appender-ref ref="ROLE_acceptance"/></logger>
    <appender name="ROLE_triage" class="dev.jagt.orchestrator.surface.ui.log.RecentLines">
        <filter class="dev.jagt.orchestrator.surface.ui.log.TaskAliasLogFilter"/>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ssX, UTC} %msg %kvp%n</pattern>
        </encoder>
    </appender>
    <logger name="dev.jagt.orchestrator.job.triage"><appender-ref ref="ROLE_triage"/></logger>

    <springProfile name="!jagt-console-logging">
    <!-- Boot's console appender, declared here to carry the alias filter every appender needs. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${CONSOLE_LOG_THRESHOLD}</level>
        </filter>
        <filter class="dev.jagt.orchestrator.surface.ui.log.TaskAliasLogFilter"/>
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${FILE_LOG_THRESHOLD}</level>
        </filter>
        <filter class="dev.jagt.orchestrator.surface.ui.log.TaskAliasLogFilter"/>
        <!-- The file is read by a machine, the console by a human: `logging.pattern.console` is the human's. -->
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>ecs</format>
            <charset>${FILE_LOG_CHARSET}</charset>
        </encoder>
        <file>${LOG_FILE:-jagt-backend.log}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>${LOG_FILE:-jagt-backend.log}.%i</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>1</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>10MB</maxFileSize>
        </triggeringPolicy>
    </appender>

    <!-- The human's: what the Master does, kept in `jagt-master.log`. -->
    <springProperty name="MASTER_LOG" source="logging.master.name" defaultValue="jagt-master.log"/>
    <appender name="MASTER" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="dev.jagt.orchestrator.surface.ui.log.TaskAliasLogFilter"/>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ssX, UTC} %highlight(%msg) %kvp%n</pattern>
        </encoder>
        <file>${MASTER_LOG}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>${MASTER_LOG}.%i</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>1</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>10MB</maxFileSize>
        </triggeringPolicy>
    </appender>
    <logger name="dev.jagt.orchestrator.job.verdict.MasterAnswerJob"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.job.master.MasterStopJob"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.job.verdict.MasterReviewJob"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.job.verdict.MasterVerdicts"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.job.verdict.MasterPlanVerdicts"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.job.master.MasterPress"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.job.conflict.ConflictHandOff"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.job.conflict.ConflictFinish"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.MasterPanel"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.MasterBriefs"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.MasterDecisions"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.MasterReview"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.MasterBrake"><appender-ref ref="MASTER"/></logger>
    <logger name="dev.jagt.orchestrator.service.master.ChargedReviews"><appender-ref ref="MASTER"/></logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
    </springProfile>

    <springProfile name="jagt-console-logging">
        <!-- Boot's structured console format, ECS, one JSON object per line on stdout; the Master's lines join it. -->
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>${CONSOLE_LOG_THRESHOLD}</level>
            </filter>
            <filter class="dev.jagt.orchestrator.surface.ui.log.TaskAliasLogFilter"/>
            <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
                <format>ecs</format>
                <charset>${CONSOLE_LOG_CHARSET}</charset>
            </encoder>
        </appender>
        <!-- What the read-only log read returns: the lines CONSOLE writes, kept in memory. -->
        <appender name="RECENT" class="dev.jagt.orchestrator.surface.ui.log.RecentLines">
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>${CONSOLE_LOG_THRESHOLD}</level>
            </filter>
            <filter class="dev.jagt.orchestrator.surface.ui.log.TaskAliasLogFilter"/>
            <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
                <format>ecs</format>
                <charset>${CONSOLE_LOG_CHARSET}</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="RECENT"/>
        </root>
    </springProfile>
</configuration>
