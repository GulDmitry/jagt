{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "skipLibCheck": true
  },
  "include": [
    "components/**/*.js",
    "core/**/*.js",
    "login.js",
    "styleguide/**/*.js",
    "ui/legend/**/*.js",
    "ui/mermaid*.js",
    "ui/tips*.js",
    "ui/toast*.js",
    "viewer/**/*.js"
  ],
  "exclude": ["node_modules", "vendor"]
}
