{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "skipLibCheck": true
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules", "vendor", "test", "coverage", "coverage-floors"]
}
