{
  "name": "jagt-board",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "prettier --check . && eslint . && tsc -p jsconfig.json && tsc -p test/jsconfig.json && jscpd",
    "format": "prettier --write .",
    "test": "c8 node --test \"test/**/*.test.js\"",
    "coverage:browser": "c8 --config .c8rc.browser.json node --test \"test/**/*.test.js\" && node --test coverage-floors/floors.test.js",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@types/node": "22.20.5",
    "c8": "12.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.18.1",
    "globals": "17.14.0",
    "htm": "3.1.1",
    "jscpd": "5.4.3",
    "preact": "11.2.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
