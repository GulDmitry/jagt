# jagt on a server: `cp jagt.server.yml.dist jagt.yml`, name your projects, set the env vars below.
# Identities come from the environment or a mounted file, never a literal here (docs/server.md).
# Code host: gh or glab read GH_TOKEN or GITLAB_TOKEN from the environment themselves.
# Each key is described in jagt.desktop.yml.dist under the same name, and nowhere else.
orchestrator:
  # data: default ~/.jagt/data, outside the checkout; /data in the container (jagt.desktop.yml.dist)
  projects:
    my-project:
      url: https://example.com/team/repo.git   # projects: cloned into the data folder; replace this placeholder, it cannot clone
      baseBranch: origin/main                  # projects
  platform: linux                              # platform
  codeHost: none                               # codeHost: github or gitlab need `gh` or `glab` in your image
  notifier: none                               # notifier
  keepAwake: none                              # keepAwake
  terminal: none                               # terminal: no window, so no kitty is needed
  multiplexer: tmux                            # multiplexer: the image holds tmux
  editor: none                                 # editor
  maxTasks: 4                                  # maxTasks: an estimate, each task's agent CLI takes a few hundred MB of the pod's 4Gi
  onStop: end                                  # onStop
  logging: console                             # logging
  agent:
    sandbox:
      enabled: false                           # agent.sandbox
  roles:
    acceptance:
      enabled: true                            # roles: the outer loop; its environments live in roles/acceptance/role.yml
    code-reviewer:
      enabled: true                            # roles: reads each request's change and posts notes; idle until a code host is chosen
    master:
      mode: act                                # roles: the Master presses what a human would; `mine` keeps its default: plan, replan and deploy stay yours
  codeReview:
    repliesToPeopleUnasked: true               # codeReview: the Master replies to every note, people's included, each asking for a rating
  # releaseFeed:
  #   autoUpgrade: false                       # true: switch to a kept release once no session is up
  deploy:
    onApproval: true                           # deploy: an approved request deploys itself, then its deploy check runs
    requireApproval: true                      # deploy: offered only once the host approves, never on a reviewed request
  autoReview:
    enabled: true                              # autoReview: reads open requests; an approval moves the task on
    waitingMaxIntervalMinutes: 60              # autoReview: a request waiting for an approval is read this often
  claude:
    mcpConfig: ${JAGT_MCP_CONFIG:}   # claude: the agent's tracker and code-host servers
  assistant:
    mcpConfig: ${JAGT_MCP_CONFIG:}   # assistant: the headless reads load these alone
  tracker:
    assignee: ${JAGT_TRACKER_USER:}            # tracker: the tracker user whose items `take` starts
  # notifications:
  #   channels:
  #     chat: { kind: teams, webhookEnv: JAGT_NOTIFY_WEBHOOK }   # notifications: the variable's NAME
  #   points:
  #     stopped: [ { channel: chat, title: "jagt · {task} · stopped", text: "{next}" } ]
  usageLimits:
    enabled: false                             # usageLimits
  auth:
    mode: password                             # auth
    passwordHash: ${JAGT_PASSWORD_HASH}        # auth: a bcrypt hash from the env var: `htpasswd -nBC 10 "" | cut -d: -f2`; the login name is always `owner`
server:
  address: 0.0.0.0                             # server
  publicUrl: ${JAGT_PUBLIC_URL}                # server.publicUrl
  forward-headers-strategy: native             # server: the ingress ends TLS and says so in X-Forwarded-*
  servlet.session.cookie.secure: true          # server: the cookie travels over HTTPS only
  servlet.session.timeout: 30m                 # server: idle time before a login ends
