# jagt on a server: `cp jagt.server.yml.dist jagt.yml`, name your projects, set the two env vars.
# Each key is described in jagt.desktop.yml.dist under the same name, and nowhere else.
orchestrator:
  projects:
    my-project:
      url: https://example.com/team/repo.git   # projects: cloned into the data folder
      baseBranch: origin/main                  # projects
  platform: linux                              # platform
  codeHost: none                               # codeHost: github or gitlab need `gh` or `glab` in your image
  notifier: none                               # notifier
  keepAwake: none                              # keepAwake
  terminal: none                               # terminal: no window, so no kitty is needed
  editor: none                                 # editor
  maxTasks: 50                                 # maxTasks
  onStop: end                                  # onStop
  logging: console                             # logging
  agent:
    sandbox:
      enabled: false                           # agent.sandbox
  roles:
    acceptance:
      enabled: true                            # roles: the outer loop; its environments live in roles/acceptance/role.yml
  usageLimits:
    enabled: false                             # usageLimits
  auth:
    mode: password                             # auth
    passwordHash: ${JAGT_PASSWORD_HASH}        # auth: a bcrypt hash, from the env var
server:
  address: 0.0.0.0                             # server
  publicUrl: ${JAGT_PUBLIC_URL}                # server.publicUrl
