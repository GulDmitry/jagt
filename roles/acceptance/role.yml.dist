# The acceptance role: a headless model that checks a deployed change against its ticket, read-only, once per deploy.
# jagt ships this frame; what you check, where and with what is yours. jagt.yml holds only roles.acceptance.enabled.
# Write what you change into `roles/acceptance/role.yml`: it layers over this file per key, a list replacing whole.
# environments, flows, workspace and model are read again on every check; the rest at start.
# A `setup.md` beside it is your own setup brief for any session to follow; nothing in jagt reads it.
# What to check and how: copy brief.md.dist to brief.md.
# Take effect: id, model, trigger, tools, answer, decline, environments, flows,
# jobs (true = the role runs jobs), readSteps (the brief steps whose turn opens its read).
# tools: shell and refuseShell are command globs, refuseRead path globs; reads are always on, writes always refused.
# tools.mcp: MCP servers or tools the read loads beside assistant.allowedTools; a bare server gives its get/list/read
# tools, a browser server also its navigation (to a listed environment only), snapshot and screenshot; click, fill and the
# like stay refused. An entry that names no MCP server is a mark on the board's head.
# trigger: deployed = the change is live; environment-named = environments names one;
# pipelines-green always holds, as the check's key is the digest the green deploy pipelines set.
# Declared for the lint only, nothing else reads them: name, oncePer (one check per deploy is fixed), outcomes.
id: acceptance
name: acceptance
model: sonnet
trigger: [deployed, pipelines-green, environment-named]
oncePer: deploy
outcomes: [round, question, wait, dispute, stop]
jobs: true
readSteps: [accept, again, decline]
tools:
  shell: ["curl -sS*", "git log*", "git show*", "git diff*", "git -C*"]
  refuseShell: ["git * --output*", "git push*", "git commit*", "git reset*", "git checkout*"]
  refuseRead: []
  git: true
  fetch: environments
  mcp: []                   # e.g. [mcp__your-logs]
# environments:             # allow-list of base URLs the role may touch; with none, no check opens and the board says so
#   - url: https://stage.example.com
#     landed: https://stage.example.com/health   # answers once the change is up, where the host reports no deploy job
# flows:                    # scripted flows, run as argv on a listed environment; evidence goes under `acceptance/` in the worktree
#   driver: none            # none | playwright; any other is a mark on the board's head
#   path: /path/to/flows    # the flows repository, the command's working directory; it holds any login
#   command: ["npx", "playwright", "test"]   # jagt adds the reporter, output folder and flow filter; BASE_URL is the environment
#   timeout: 10m            # a run past it is unprovable
# workspace: the one folder the role writes: scenarios, steps and flows it keeps; a relative path is the role folder's, none = memoryless
workspace: workspace
answer:
  - required: failure
  - records: rows
    fields: [criterion, status, evidence]
    choices: {status: [met, "not met", unprovable]}
  - text: question
  - text: waitingOn
  - texts: flows
  - text: environment
decline:
  - required: failure
  - text: dispute
