state.json
state.json.bak
state.json.corrupt
state*.json.tmp
opencode-gate/
.omc/
.idea/
*.iml
build/
.gradle/
node_modules/
.DS_Store
.classpath
.project
.settings/
.factorypath
config.json
jagt.yml
# Retired, and refused at startup: Spring auto-loads ./config/ at a precedence that outranks jagt.yml.
orchestrator-backend/config/
target/

# Backend runtime log (logback writes to the process cwd — repo root when the jar
# is run there, or orchestrator-backend/ — including rotated .log.<date>.<n>.gz files)
jagt-backend.log*
jagt-master.log*
orchestrator-backend/*.log*

# Junk empty files created in the repo root by the terminal (stray redirects/pastes)
/BA0
/N

# Eclipse/VS Code Java output (not used by Gradle)
orchestrator-backend/bin/
orchestrator-backend/*/bin/
CLAUDE.local.md

# Steps no case sends, written beside state.json
misses.jsonl
misses.jsonl.1
stops.jsonl
stops.jsonl.1
stops-reviewed.jsonl
# What the router worked out about this install: written by it, edited by you, local to this machine
memory/

# Records of finished tasks, written beside state.json and never read back
finished.jsonl
usage-by-day.jsonl
usage-alerts.properties
interactions.jsonl
interactions.jsonl.1
/archive/
# The roleEval -Prole=master suite's own root, trusted once by a human and rebuilt each run, and its run lock
.master-eval/
.master-eval.lock
# The roleEval suite over a checker's own root, rebuilt each run
.qa-eval/
# Present while the Master's act is stopped, written beside state.json
act-stopped
act-strikes
intake-turned-away
# The plan each task last had approved, written beside state.json
plan-baselines/
# Where a task with no repository plans, written beside state.json
scratch/
# The Master's MCP token, drawn by jagt at each start
/.jagt/

# Open ideas, collected on this machine
TODO.md
QUESTIONS.md
IDEAS.md
ORDERS.md
TESTBED.md
DETERMINISM.md

# Pass/fail per eval case across runs, written by promptEval and roleEval
orchestrator-backend/eval-stats.jsonl*
orchestrator-backend/suite-stats.jsonl
.jqwik-database

# A human's copy of a role file, made from its .dist beside it; the shipped .dist files and eval/ cases stay tracked
roles/*/*
!roles/*/*.dist
!roles/*/eval/

# Held specs: text of behaviour not yet built, kept out of the tree
openspec-held/
