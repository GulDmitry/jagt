{
  "viewer": {
    "tmuxSession": "jagt",
    "viewMode": "shared",
    "keepViewer": true
  },
  "dashboard": {
    "refreshSeconds": 10,
    "reservedRows": 17
  },
  "codeReview": {
    "mrTitlePattern": "{ticket} {title}",
    "postReviewReplies": true,
    "reviewReplyAuthors": [],
    "mergeRequestDefaults": {
      "removeSourceBranch": true,
      "squash": true
    }
  },
  "autoReview": {
    "enabled": false,
    "windowHours": 24,
    "minIntervalMinutes": 10,
    "maxIntervalMinutes": 60
  },
  "agent": {
    "outputStyle": ""
  },
  "worktree": {
    "copyGlobs": ["**/.env"]
  },
  "projects": {
    "my-project": {
      "path": "/absolute/path/to/base/repository",
      "baseBranch": "origin/main",
      "deployBranch": "dev",
      "labels": [
        "proj",
        "my-project"
      ]
    }
  }
}
