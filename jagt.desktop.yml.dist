# jagt — your whole configuration, and the only file there is: `cp jagt.desktop.yml.dist jagt.yml`, then fill in ONE
# project. Every other key already has the value shown and can stay commented out.
# `projects`, `viewer`, `agent`, `worktree`, `codeReview`, `autoReview`, `tracker`,
# `loopBreaker`, `conflictStallMinutes`, `maxTasks`, `notifications`, `archive` and `roles` are re-read on every access;
# every other key is read once, at startup.
# A string takes `${VAR}`, `${VAR:default}` and `${file:/path}` (a mounted secret; one trailing newline is cut); a variable
# `JAGT__a__b=value` then sets the key `a.b`, `JAGT__orchestrator__projects__x__path` for one under `orchestrator`. An unset
# variable with no default refuses the start.

orchestrator:

  # ── Your repositories ──────────────────────────────────────────────────────────────────────────────────────
  # The only section with no default. `deploy` merges a task into `deployBranch`, which must differ from
  # `baseBranch`, or jagt refuses to start.
  projects:
    my-project:
      path: /absolute/path/to/base/repository   # used as is when it exists; nothing is cloned there
      # url: https://example.com/team/repo.git   # cloned into <data>/projects/<project> where `path` is blank or missing;
      #                             # fetched before each task starts; the clone CLI's own credentials; a failure marks the board's head
      # localFiles: /path/to/local-files   # the folder `worktree.copyGlobs` copies from into every new worktree (an .env a clone lacks);
      #                             # blank = the project's path
      baseBranch: origin/main       # tasks are cut from here; jagt never pushes to it
      deployBranch: dev             # omit to disable deploy for this project
      # labels: [proj, my-project]  # ticket labels suggesting this project where `do` names none
      # about: "the Java backend behind the customer portal"   # what this repository IS, in one line, for
      #                             # placing an item no label places; its path is used where you write none
      # verifyCommand: ["./gradlew", "test"]   # jagt runs it in the worktree before a hand-back reaches you;
                                               # a failing run goes back to the agent, never to your IDE
      # verifyMinutes: 20   # minutes the verify command may run before jagt stops it; 20 where you write none
      # setupCommand: ["sh", "-c", "cp -al ../node_modules ."]   # run once in every new worktree of this project, after
                                               # `worktree.copyGlobs` and before the session starts; {branch} and {worktree} are filled;
                                               # a non-zero exit or the limit fails the start, no session opens
      # setupMinutes: 20    # minutes the setup command may run before jagt stops it; 20 where you write none
      # humanPaths: ["**/auth/**", "**/*secret*"]   # in `roles.master.mode: act`, a task changing a path these globs
      #                             # name is shipped and deployed by you alone; the master window names the path

  # ── The code host ──────────────────────────────────────────────────────────────────────────────────────────
  # What jagt reads a deploy's pipeline through; never guessed from a host name. The CLI or command holds the credential.
  # codeHost: github        # github (default) | gitlab | command | none | replay. Under a project, `codeHost` wins over this one.
  #                          # `none`: ship pushes the branch alone, opens no request, and the deploy is next. `replay`: beside `agent.cli: replay`.
  #                         # none: no pipeline is read, a deploy settles without one
  # Per project, beside `path`:
  #   remote: origin                          # the git remote branches are shared through; none: a repository kept on this machine
  #                                           # (worktrees cut from the local base, nothing fetched or pushed; codeHost must be none)
  #   codeHostName: git.example.com           # the host, where the remote does not name it (a self-hosted GitLab, GitHub Enterprise)
  #   pipelineCommand: ["ci-state", "{sha}"]  # codeHost command: run in the project's directory, prints success | failed | running | none | unknown
  #   retryCommand: ["ci-rerun", "{pipeline}"]  # optional: re-runs a pipeline that died on infrastructure
  #   closeCommand: ["ci-close", "{request}"]   # optional: closes the open request at {request}, for `remove-repo`
  #   notesCommand: ["ci-notes", "{request}"]   # optional: prints the ids of the request's unresolved review notes, one per line; unset = none, so a round is never read as a repeat
  #   loginCommand: ["ci-login", "--web"]       # optional: what the board's `login` opens when pipelineCommand exits 77 (signed out)

  # ── Platform ───────────────────────────────────────────────────────────────────────────────────────────────
  containers: docker-compose # docker-compose | none. `docker compose down -v` for each Compose project started inside a task's worktree, run as it is removed
  supervisor: none         # none | launchd. `launchd` (macOS): the board's `supervise` has the machine keep the staged jar running and restart it on exit; `restart` starts the new jar
  # platform: linux        # macos | linux. Detected from the machine; set only to override, refused when it is not what the machine reports
  archive:
    maxMegabytes: 20       # `archive/` beside state.json, what `done` keeps; past it the oldest snapshots go first
  loopBreaker:             # stops a task jagt suspects it is looping on, whoever asked; your `lift` or the Master's resumes it
    stalledRounds: 3       # rounds relayed running that brought no new note and left the same job failing (at most 19)
    ships: 4               # ships within autoReview.windowHours whose round brought no new note;
                           # the next one jagt would press unasked stops the task
    rounds: 3              # rounds of one step sent back running in 24h: a red verification or probe, a not-ready
                           # plan or round, counted while it answers an unchanged report; the next one stops the task (at most 19)
    perHour: 20            # unattended moves (Master, auto-review, tracker) of one task in an hour; the next one stops it (at most 49)
  conflictStallMinutes: 20 # in act, a deploy conflict its session was handed whose worktree has not changed this long:
                           # you get one banner, and the card says how many paths are unmerged, where, since when
  maxTasks: 50            # open tasks at once; the next `do` is refused until one is done
  onStop: keep            # keep | end. `end` (a server): stopping jagt ends every live session as gone, windows closed;
                          # `keep`: sessions outlive a restart
  keepAwake: none         # none | true. `true`: the machine stays awake while the Master acts, auto-review polls or `take` runs; `none` holds nothing
  logging: file            # file | console. `console`: every line, the Master's included, is one ECS JSON object on stdout and no log file is written (a container); `file`: the files under logs/
  interactionLog: true    # what you press on the board, to `interactions.jsonl` beside state.json; 1 MB, one `.1`
  # terminal: kitty       # kitty | ghostty | none: the viewer; ghostty is macOS only and needs Ghostty 1.3 or newer; `none` opens no window, needs no kitty and `focus` names this key
  # kittyCommand: kitty   # if the binary is not on PATH
  # kittyFontSize: 13     # blank keeps kitty.conf's own
  tmuxCommand: tmux       # a bare name is resolved on PATH and in the usual install dirs
  # tmuxSocket: jagt      # a named tmux server (-L): jagt's sessions stay apart from yours; empty = the default server
  # notifier: desktop     # desktop | none: banners through the platform's notifier; `none` shows no banner, startup says so
  # terminalNotifierCommand: terminal-notifier   # macOS: clickable banners; falls back to osascript
  # notifySendCommand: notify-send               # Linux: the libnotify sender

  # Any CLI launcher; the worktree path is appended. NOT `open -a`, which activates the app but opens nothing.
  # editor: cli           # cli | none: `none` opens no editor, and `open` and `diff` name this key
  # Unset, `code` opens the board's Code tab alone; set, it also launches the editor.
  # editorCommand: ["idea"]
  # editorDiffCommand: ["idea", "diff"]   # optional; two paths are appended: <left> <right>
  # VS Code: editorCommand: ["code"], editorDiffCommand: ["meld"] (brew install --cask meld) — VS Code compares no folders

  # ── The viewer ─────────────────────────────────────────────────────────────────────────────────────────────
  viewer:
    tmuxSession: jagt     # tmux reserves ':' and '.' — a name carrying either is unaddressable
    viewMode: shared      # shared | tab-per-task
    keepViewer: true      # keep the agents window open after the last task closes

  # ── The agents ─────────────────────────────────────────────────────────────────────────────────────────────
  agent:
    # cli: codex          # claude | codex | opencode (stub, replay: test runs); read at startup, unlike the two below. A Codex worktree runs
    #                     # against its own CODEX_HOME, so your ~/.codex servers are not there.
    model: ""             # the model a session starts on when its notes name none; blank inherits your CLI default
    models: []            # the names a session may be told, replacing the CLI's own list; empty keeps it (Codex has none)
    tiers: [sonnet, opus] # models a stopped session may be moved up through with `escalate`, lowest first; the first stands for the start model; []: none
    cacheLifetime: 1h     # idle past this, a prompt goes to a fresh session; 0: never (a local model)
    notesEvery: 30m       # task_notes.md older than this at a turn end: the session rewrites it once; 0: never
    submitWait: 700ms     # a nudge left in a window's input gets Enter again after this wait, three times at most; 0: no wait
    draftPoll: 1s         # a nudge waits for the human's line in a window, looking again this often; 0: no wait
    probeSeconds: 600    # how often every running session's liveness is probed
    sandbox:              # true: a session's shell writes only in its task's worktrees, /tmp, the user's temp dir and the tool caches;
                          # a write beyond asks you in the session's window. Claude's sandbox then lets only its web proxy out, which
                          # a JVM build (Gradle, Maven) does not use: it cannot reach the network
      enabled: false      # off: it writes wherever the agent CLI's own rules let it. Linux needs bwrap and socat when true
    #   allowWrite: []    # added to those, e.g. ~/www/specs; the Master's reads read them too, sandbox on or off
    #   excludedCommands: []   # run outside it beside git's remote verbs and ssh, e.g. "~/bin/db-tunnel *"
    # autoplan:           # a session plans first, unasked, when its task is large or unclear; the plan says why
    #   enabled: false
    #   files: 30         # "large": it changes more files than this
    visualize:            # a session sketches a task worth a picture in task_visual.md: ASCII for a screen, Mermaid
                          # for the backend; the board's Files tab shows it
      enabled: true       # unset: off
    # diagnose:           # a session diagnoses a bug from facts and a control before it reads code for a cause
    #   enabled: false

  claude:
    command: claude       # also used by the headless reads, which stay Claude whichever agent runs the tasks
    # mcpConfig: /path/to/servers.json   # a session loads jagt's server and these alone, none of yours
    outputStyle: ""       # a Claude output style to start every sub-agent with; read at startup
    # disabledPlugins:    # Claude plugin ids; dropping an LSP plugin buys memory and costs the agent its code intelligence
    #   - jdtls-lsp@claude-plugins-official
  # codex:
  #   command: codex
  # opencode:           # agent.cli: opencode; no sandbox, so agent.sandbox.enabled must stay false
  #   command: opencode
  #   endpoint: ""      # an OpenAI-compatible base URL, e.g. http://127.0.0.1:8080/v1; blank: your own OpenCode config picks the model
  #   model: ""         # the model name that endpoint serves; required with an endpoint
  #   reads: {acceptance: qwen-4b}   # roles whose read runs on OpenCode at the endpoint; master = the round reads; blank model = model

  # What a session is told at each step jagt sends it: roles/session/brief.md.dist; copy it to roles/session/brief.md to edit a step.
  # When jagt may send each step: roles/session/cases.md.dist; copy it to roles/session/cases.md to edit a case.
  # When the Master may press a verb: roles/master/cases.md.dist; copy it to roles/master/cases.md to edit a case.

  watchdog:
    staleAfter: 5m        # silence before an "agent stopped" alert; a hook report needs no wait

  # Pre-approved in every session: a ship's request and its replies write to the code host, which the auto-mode
  # classifier may refuse otherwise. One comma-separated line; never a merge tool, the base branch is read-only.
  # agentAllowedTools: mcp__your-gitlab-mcp__save_merge_request, mcp__your-gitlab-mcp__save_note

  worktree:
    copyGlobs: ["**/.env"]   # gitignored files carried from the base repository into every fresh worktree

  # ── Reading tickets, merge requests and review rounds ──────────────────────────────────────────────────────
  # The only place jagt spends model money. Each read is a HEADLESS one-shot of your agent CLI: no interactive
  # login, and a plugin's MCP server only with `user` in settingSources. Read docs/installation.md before trusting it.
  # `agent.cli: stub` (the e2e matrix's) replaces the task agent alone: `do` and the reads still run `claude.command`.
  assistant:
    model: haiku                        # blank inherits your own; the reads are mechanical
    settingSources: user,project,local  # NOT `project` alone: the call runs from a temp dir, which has none
    maxCostUsd: 2.55                    # a headless call stops at this spend and its read fails naming it
    breakerFailures: 3                  # consecutive model-provider failures (5xx, overloaded, network; never a usage limit) that stop every headless read
    breakerCooldown: 5m                 # how long reads stay stopped; then one probe read closes the breaker on success, re-opens it on failure
    # allowedTools: [mcp__your-jira-mcp, mcp__your-gitlab-mcp]   # a bare server gives a read its get*/list*/search*/
    #                     # read*/fetch*/find*/describe*/lookup*/*discussions*/*notes* tools, a full tool name
    #                     # that tool too; the Master's review calls these alone, and with none it loads no server
    # mcpConfig: /path/to/mcp-servers.json   # pin the servers instead of inheriting all of them; handed to `claude --mcp-config` as is
    # mcpConfigByKind:                       # one list per kind of read, so a cheap one loads only what it needs
    #   TICKET_READ: /path/to/tracker-only.json     # falls back to mcpConfig, then to your own configuration
    #   REVIEW_SWEEP: /path/to/code-host-only.json  # kinds: TICKET_READ, MR_READ, REVIEW_SWEEP, COMMAND_MAP, INTAKE, ROUTE, MASTER_REVIEW
    # local:                                 # a read that needs no tool may ask a local OpenAI-compatible server instead of the cloud
    #   endpoint: http://127.0.0.1:8080/v1   # blank = off; llama-server, LM Studio and Ollama all serve /v1/chat/completions
    #   model: unsloth/Qwen3.5-9B-GGUF:Q4_K_M   # as the server lists it at /v1/models; per memory size: docs/local-models.md
    #   timeout: 20s                         # per call; a failed or late call is asked of the cloud once
    #   kinds: [COMMAND_MAP]                 # only COMMAND_MAP reads no tool; the default stays cloud until `promptEval` shows parity

  # ── The roles ──────────────────────────────────────────────────────────────────────────────────────────────
  # A checker is a headless model that reads a deployed change, read-only, once per deploy; what it finds goes
  # back to the session as a round. One block per role, under `roles`, by the role's id. With a checker on,
  # `DeployCheckJob` asks the session nothing: one check per deploy, never two. Needs the tracker's `doneStatus`
  # and your own MCP for logins. A checker's own options live in its folder, roles/<id>/role.yml; here it is on or off.
  roles:
    # master:               # the arbiter: an unattended reviewer that reads what a task produced before you do.
    #                       # It judges unless you turn it off; what each mode does and costs: docs/usage.md#the-master.
      # mode: judge            # off | judge (reads and writes what it found) | act (also presses the button).
                               # Unset: judge where the agent CLI lets jagt read what you typed (Claude), else off.
                               # Three tasks in a row act moved ending badly stop it until you press `act stopped`.
      # brief: roles/master/brief.md # what it judges by: copy roles/master/brief.md.dist to this name and edit it. Relative
                               # to this file. Unset and not copied, the shipped .dist; named and missing, refused
      # model: fable           # reading is the cheap half, so it can run a heavier model than the work does;
                               # blank inherits the agent CLI's. One run per role of the brief, per round;
                               # a `model` column in the brief's role table overrides it for that role
      # mine: [plan]           # the steps and verbs that stay YOURS in `act`: ship, deploy + revert (together), reply, answer,
                               # plan, repo, lift, or any other verb id (done, trust, escalate, pause, remove-repo, a command).
                               # Unset: [plan]; [] hands the Master every verb. Anything not listed the Master may do;
                               # a plan you opened in `plan` mode is always yours
    acceptance:             # checks a deployed change against its ticket on a running environment
      enabled: false        # off: the session checks its own deploy
                            # everything else, environments, model and runner, lives in roles/acceptance/role.yml,
                            # described in role.yml.dist there; written here, it refuses the start

    triage:                 # reads each stop once, read-only: who looped, its defect family, whether a lift looks safe
      enabled: false        # off: a stop carries no triage line on its hover; on: one read per stop, charged as the Master's
      # model: haiku        # the model of the read; blank inherits the agent CLI's

  # LEGACY, still read: `master:` with the same keys as `roles.master`. Where `roles.master` is written it wins;
  # unwritten, this stands.
  # master:
  #   mode: judge

  # The role was called `qa`: neither `qa:` nor `roles.qa` is read, and jagt refuses to start while either is written.

  # ── The two ends the tracker drives (EXPERIMENTAL) ─────────────────────────────────────────────────────────
  # `take` turns items at your starting stage into tasks; `close` ends a task whose item reached the stage that
  # says the work landed. Each end asks only for the stage IT reads. Every stage name is YOUR workflow's:
  # nothing here has a default, because a guessed stage starts work nobody asked for.
  # Per poll: one search, then one read per item it has not seen. Labels naming exactly one project place the
  # item; otherwise a routing call OPENS the item and reads it against each project's `about`. A routing call
  # that fails is asked again next poll; only one that read the item and placed it nowhere turns it away.
  # It is also shown where items like it were finished before — only the ones you placed yourself or a deploy
  # confirmed, read off `finished.jsonl`, so it never learns from a guess of its own. With one repository configured there is
  # nothing to choose and nothing is asked.
  tracker:
    mode: off             # off | take | close | both
    workflow: none        # none | jira | file. Read at startup, unlike everything beside it here
    file: ""              # `file`: the Markdown checklist jagt reads itself, `- [ ] **ABC-42 — Title**`; `[ ]` is `open`, `[x]` `done`
    assignee: ""          # `take`: the item is yours, spelled exactly as your tracker reports it, case aside
    startStatus: ""       # `take`: the stage an item must stand in before a machine may start it
    projects: []          # `take`: the tracker projects (boards) work is taken from, by key; empty takes from all
    doneStatus: ""        # `close`: the stage that says the work landed; reaching it closes the task
    everyMinutes: 10      # a task the tracker has not moved is then asked about ever less often,
                          # doubling to twice a day, so a deploy nobody finishes stops costing reads
  # It writes what placed an item no label could place to `memory/routing.md`, one rule per line, each with
  # how many items it has placed. Past 60 the least used goes, not the oldest. A rule stops being used when
  # the router changes its mind or when you place yourself an item it had placed elsewhere, and is kept,
  # commented out with the date. Open the file and fix a line: it outranks everything else the router is shown, and you can
  # write rules there before the first item of their kind ever arrives.

  # ── Review rounds ──────────────────────────────────────────────────────────────────────────────────────────
  codeReview:
    mrTitlePattern: "{ticket} {title}"
    postReviewReplies: true    # false leaves every reply a draft that you post yourself
    reviewReplyAuthors: []     # post a reply only where the note it answers is by these authors; empty = all

  # Unattended polling of open review requests: it only READS and DRAFTS, never ships, deploys or posts.
  # The one exception is `infraWait`: jagt re-runs a pipeline the host says died on infrastructure.
  # One model call per poll — 24h on one request is $3–$7.
  autoReview:
    enabled: false
    windowHours: 24         # stop polling a round this old
    minIntervalMinutes: 10
    maxIntervalMinutes: 60
    waitingMaxIntervalMinutes: 60    # a request only a reviewer can move on is read past the window too, lengthening to this

  # An approved request waits for your `deploy`. On, jagt presses it once when the code host approves,
  # after the same guards: checks green, no conflict, the base branch read-only. A conflict waits for you.
  # deploy:
  #   onApproval: false

  # ── Infrastructure failures ────────────────────────────────────────────────────────────────────────────────
  # A pipeline the host says died on infrastructure, not on the code, is re-run by jagt after each wait here; one
  # still red after the last is handed to you, and the session never hears of it. The same waits space the probes of
  # a session whose dependency is down (`outcome=wait`). [] turns both off.
  infraWait:
    backoff: [5m, 15m, 45m]

  # ── Subscription limits ────────────────────────────────────────────────────────────────────────────────────
  # Read through the agent CLI's own stored login, never kept; shown in `stats` and told as a banner, never a gate.
  usageLimits:
    enabled: true             # false: nothing is read, told or shown
    every: 30m
    thresholds: [80, 95]      # % of a window, each told once per window period
    paidThresholds: [80, 95]  # % of paid usage's monthly limit; the first paid spend is always told
    wakeOnReset: false        # say one line to a session that stopped on a full window, when it resets

  # ── Safety ─────────────────────────────────────────────────────────────────────────────────────────────────
  startupChecks: true     # refuse to start when part of the installation is missing

  # ── Almost nobody sets these ───────────────────────────────────────────────────────────────────────────────
  # data: /data                  # everything jagt writes: state, tasks/<task>/worktrees/<project>, projects, logs; default <root>/data
  # root: /path/to/jagt          # where jagt finds `jagt.desktop.yml.dist` and the roles; default the jagt checkout
  # previousData: ~/.jagt         # the older default data folder; what it holds is moved into the data folder once; default ~/.jagt
  # stateFile: /path/to/state.json   # where the tasks are kept; default `data`/jagt/state.json
  # board:
  #   dir: /path/to/board       # serve the board from this folder, relative: against `root`; an edit shows on reload; default the jar's copy
  # mcpUrl: http://127.0.0.1:8290/mcp                   # these three follow `server.port`
  # hookUrl: http://127.0.0.1:8290/api/agent/session
  # gateUrl: http://127.0.0.1:8290/api/agent
  # stub:
  #   script: …                # the e2e matrix's scripted agent
  # replay:
  #   file: …/recording.jsonl  # `agent.cli: replay` plays a stand run's sessions, reads and verdicts back, no model
  # configFile: cannot live here, it says where THIS file is:
  #   `--orchestrator.config-file=…` or `ORCHESTRATOR_CONFIG_FILE=…`

  # ── Notifications ──────────────────────────────────────────────────────────────────────────────────────────
  # A point is a fact that stands; a route tells it to a channel, once per fact. A point no route names is told to
  # nobody, and with no route at all the start says so. Shown: today's banners.
  # your-move: a task's move became yours, or an agent's own word to you   stopped: a stop, an ask or silence
  # auto-review: a review window elapsed, a poll gave up, a request is gone  conflict-stalled: a handed conflict stopped moving
  # request-opened: a task's request opened   housekeeping: orphaned worktrees, intake refused
  # install: restart needed   usage: a usage window filled
  # Also: checks-green, checks-failed, approved, deploy-pressed, deployed, deploy-conflict, reverted, merged, done,
  # master-sealed, master-asked-stop, master-left, master-unanswered, master-pressed-deploy, master-shipped-commented,
  # and <role>-passed, <role>-round-sent, <role>-declined of an enabled role.
  # A title and a text are templates: {task} {alias} {ticket} {status} {said} {next} {project} {requests} {request}
  # {pipeline} {sha} {board} {role} {stop} {origin}; {title} {body} are the point's own words. A point raised with no
  # task (housekeeping, install, usage) has no value for the task ones. A route with no text, an unknown placeholder,
  # a channel not under `channels` or an unknown point refuses the start, all problems at once.
  notifications:
    channels:
      desktop: { kind: desktop }                          # a banner; a click opens the task on the board
      # ops: { kind: command, command: ["sh", "-c", "curl -s -X POST -H 'Content-Type: application/json' -d @- \"$OPS_WEBHOOK\""] }
      #                                                   # stdin: one JSON object {"event","task","alias","title","body"}
      # chat: { kind: teams, webhookEnv: TEAMS_WEBHOOK_URL }   # a Workflows webhook URL in that env var; links in the text become buttons
    points:
      your-move:        [ { channel: desktop, title: "jagt · {alias} · {task} · {title}", text: "{body}" } ]
      stopped:          [ { channel: desktop, title: "jagt · {alias} · {task} · stopped", text: "{next}" } ]
      auto-review:      [ { channel: desktop, title: "jagt · {alias} · {task} · auto-review", text: "{next}" } ]
      conflict-stalled: [ { channel: desktop, title: "jagt · {alias} · {task} · conflict stalled", text: "{next}" } ]
      request-opened:   [ { channel: desktop, title: "jagt · {alias} · {task} · request opened", text: "{requests}" } ]
      housekeeping:     [ { channel: desktop, title: "jagt · {title}", text: "{body}" } ]
      install:          [ { channel: desktop, title: "jagt · {title}", text: "{body}" } ]
      usage:            [ { channel: desktop, title: "jagt · {title}", text: "{body}" } ]
      # deployed: [ { channel: desktop, title: "jagt · {alias} · deployed", text: "{sha}" }, { channel: ops, title: "deployed", text: "{alias} is live: {sha}" } ]

  # ── Who may open the board ─────────────────────────────────────────────────────────────────────────────────
  # The board can deploy, close a task and start an agent, so beyond loopback it needs a login.
  auth:
    mode: none             # none | password | oidc. `none` is loopback only: a `server.address` beyond it, `allowedHosts`, or a non-loopback `server.publicUrl` refuses the start.
                           # `password` and `oidc` guard the board, /api and its streams; sessions and the Master reach /mcp and /api/agent/
                           # by their own token and worktree header, never a login.
    # oidc:                          # for `mode: oidc`; a missing key refuses the start
    #   issuerUri: https://sso.example.com/realms/main   # the provider's issuer; its discovery document is read on the first login
    #   clientId: jagt
    #   clientSecretEnv: JAGT_OIDC_SECRET   # the NAME of the environment variable holding the client secret, never the secret
    #   allowed: owner@example.com          # the one subject or email let in; any other login is refused
    # passwordHash: "$2y$10$…"   # a bcrypt hash, never the password: `htpasswd -nBC 10 "" | cut -d: -f2`
    # backoff:                           # `password`: a peer address failing the password `failures` times is refused 429 for `duration`
    #   failures: 5
    #   duration: 5m
    #   peers: 10000                     # addresses remembered; the least recently seen is dropped
    # allowedHosts: [jagt.example.com]   # further host names an ingress forwards the board under; `server.publicUrl`'s host needs no entry

# The board listens on loopback: with `auth.mode: none` it asks for no password and can deploy, close a task and start an agent.
server:
  address: 127.0.0.1
  port: 8290
  # forward-headers-strategy: native         # behind a TLS ingress: read X-Forwarded-*, so redirects and the peer address are the client's
  # servlet.session.cookie.secure: true       # behind TLS: the login cookie travels over HTTPS only
  # servlet.session.timeout: 30m              # idle time before a login ends
  # publicUrl: https://jagt.example.org   # the board's address as a human reaches it; every link jagt sends (banner, channels) starts with it;
  #                                        # blank = http://localhost:<port>. The mcp, hook and gate URLs stay loopback.
